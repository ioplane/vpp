FROM registry.fedoraproject.org/fedora@sha256:02031526999d46c9f9c6490eeccf4cafd735438b9d0fb5e1d9fc941d7886e2ff

RUN dnf install -y --setopt=install_weak_deps=False \
      binutils clang clang-tools-extra cmake gcc gcc-c++ git make ninja-build \
      curl file diffutils patch tar xz which \
      openssl-devel numactl-devel libunwind-devel elfutils-libelf-devel \
      libnl3-devel libmnl-devel python3 python3-pip python3-ply python3-jsonschema \
    && curl --fail --show-error --location \
      https://files.pvs-studio.com/pvs-studio-8.01.110904.869-x86_64.rpm \
      --output /tmp/pvs-studio.rpm \
    && echo '79acea7166d63ee622d4bcbadf9f29750197ef21ffefc25b669eff65053bd866  /tmp/pvs-studio.rpm' \
      | sha256sum --check - \
    && dnf install -y --setopt=install_weak_deps=False /tmp/pvs-studio.rpm \
    && dnf clean all \
    && rpm -qa --qf '%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}\n' | sort > /opt/builder-rpms.txt

RUN dnf install -y --setopt=install_weak_deps=False hostname \
    && dnf clean all \
    && rpm -qa --qf '%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}\n' | sort > /opt/builder-rpms.txt

WORKDIR /work
COPY . /work
ARG GIT_SHA
ARG VPP_DESCRIBE
RUN test -n "$GIT_SHA" && test -n "$VPP_DESCRIBE" \
    && printf '%s\n' "$GIT_SHA" > .pvs-source-sha \
    && printf '%s\n' "$VPP_DESCRIBE" > src/scripts/.version \
    && cmake -S src -B build-pvs -G Ninja -DCMAKE_BUILD_TYPE=release \
       -DCMAKE_C_COMPILER=/usr/bin/clang -DVPP_BUILD_NATIVE_ONLY=ON \
       -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
    && cmake --build build-pvs --parallel 2 --target nat_plugin ikev2_plugin \
    && mkdir -p pvs-report
ARG CREATED
LABEL org.opencontainers.image.title="VPP Fedora PVS-Studio analysis" \
      org.opencontainers.image.description="Native Clang build and isolated NAT/IKE analysis" \
      org.opencontainers.image.source="https://github.com/ioplane/vpp" \
      org.opencontainers.image.revision="$GIT_SHA" \
      org.opencontainers.image.version="fedora46-pvs8.01.110904.869" \
      org.opencontainers.image.created="$CREATED" \
      org.opencontainers.image.licenses="NOASSERTION" \
      org.opencontainers.image.base.name="registry.fedoraproject.org/fedora:46" \
      org.opencontainers.image.base.digest="sha256:02031526999d46c9f9c6490eeccf4cafd735438b9d0fb5e1d9fc941d7886e2ff"
